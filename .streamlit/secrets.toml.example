# Copy this file to .streamlit/secrets.toml and fill it in.
# secrets.toml is listed in .gitignore, so it never gets pushed to GitHub.

APP_PASSWORD = "choose-an-organiser-password"

# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "yourteam@gmail.com"
SMTP_PASSWORD = "your-16-character-app-password"
SENDER_NAME = "IEEE Student Branch"

# Optional: the address phones open when scanning a certificate QR code.
# Leave it out to detect this computer's Wi-Fi address automatically.
# VERIFY_BASE_URL = "http://192.168.1.5:8501"
